# Copy this file to .env locally and keep the real values in a secret manager.
# Never commit the filled-in .env file.

ALEXA_SKILL_ID=replace-with-your-alexa-skill-id
GATEWAY_URL=https://your-gateway.example.com
GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret
GATEWAY_MAX_SKEW_SECONDS=300

# Local development only; bind to loopback unless you know why otherwise.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# Optional, explicitly configured read-only adapter.
AI_API_URL=
AI_API_TOKEN=

# Optional notification only. The example does not forward the spoken text.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_REQUEST=false
